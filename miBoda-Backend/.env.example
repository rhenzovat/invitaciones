APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# cPanel: Laravel en /laravel y web en /public_html (opcional; también autodetecta)
# PUBLIC_WEB_ROOT=/home/royalsen/public_html

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


RECAPTCHA_SITE_KEY=TU_SITE_KEY_V2_CHECKBOX
RECAPTCHA_SECRET_KEY=TU_SECRET_KEY_V2_CHECKBOX

# Web Push (alertas campus con navegador minimizado)
# Generar: php artisan notificacion:vapid-generar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@royalsensorymassage.com
FRONTEND_URL=https://royalsensorymassage.com/admin

# Panel admin (React) — solo en local
# APP_URL_FROND=http://localhost:5173
# ADMIN_DIST_PATH=   # vacío + APP_ENV=local → Laravel redirige a Vite :5173 (no usa public/admin)
# ADMIN_DIST_PATH=C:/xampp/htdocs_pro/37-masajes-royal/systemWeb-Frontend/dist  # opcional: probar build en dist/
# En cPanel el admin vive en public_html/admin (subido manualmente o con LARAVEL_ADMIN_TARGET)

# Swagger / OpenAPI documentation
L5_SWAGGER_CONST_HOST=https://royalsensorymassage.com/api
L5_SWAGGER_GENERATE_ALWAYS=false
L5_FORMAT_TO_USE_FOR_DOCS=json
